{
  "name": "@atc-web/notify",
  "version": "1.1.0",
  "private": true,
  "description": "Notification service: queued email and signed webhook delivery over HTTP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/notify.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "api": "node --disable-warning=ExperimentalWarning src/api-main.js",
    "worker": "node --disable-warning=ExperimentalWarning src/worker-main.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@atc-web/service-core": "github:alitalipcalikoglu/service-core#v1.12.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.4",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/nodemailer": "8.0.2",
    "typescript": "7.0.2"
  }
}
