# --- Server ---
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=65536

# --- Storage ---
DB_PATH=./data/notify.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
RETENTION_DAYS=30

# --- Auth: id:secret pairs, comma separated. Secrets >= 32 chars. Generate: openssl rand -hex 32
NOTIFY_API_KEYS=shop:REPLACE_WITH_64_HEX_CHARS,blog:REPLACE_WITH_64_HEX_CHARS
RATE_LIMIT_MAX=600

# --- Email ---
# nodemailer URL. Use "json:" locally to log mails instead of sending.
SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_FROM="Example App <no-reply@example.com>"

# --- Webhooks (legacy signed webhook for one-off calls; for durable/retry-oriented delivery use webhook-out) ---
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARS
# Optional allowlist (exact host or parent domain). Empty = any public host.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_TIMEOUT_MS=10000
# Set to false to turn the webhook channel off entirely (email unaffected). Default true, backward compatible.
NOTIFY_WEBHOOK_CHANNEL=true

# --- Delivery ---
MAX_ATTEMPTS=8
BACKOFF_BASE_MS=5000
BACKOFF_CAP_MS=3600000
WORKER_CONCURRENCY=5
WORKER_POLL_MS=500
LOCK_TTL_MS=120000

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=notify:…:write
AUDIT_URL=
AUDIT_API_KEY=
